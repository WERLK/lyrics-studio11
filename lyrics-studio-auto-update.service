[Unit]
Description=歌词工坊自动更新服务
After=network.target nginx.service
Requires=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lyrics-studio
ExecStart=/opt/lyrics-studio/auto-update.sh --daemon
Restart=always
RestartSec=10
StandardOutput=append:/var/log/lyrics-studio-auto-update.log
StandardError=append:/var/log/lyrics-studio-auto-update.log

# 资源限制
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
